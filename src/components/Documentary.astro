<section class="documentary" id="documentary" aria-labelledby="documentary-heading">
  <header class="documentary__header">
    <h2 id="documentary-heading" data-reveal>The Boat and Its Crew<br />Have Their Own Documentary</h2>
    <p class="documentary__label" data-reveal><span aria-hidden="true"></span>Behind the journey</p>
  </header>
  <div id="documentary-film" class="documentary__film" data-reveal>
    <img class="documentary__poster" src="/images/arctic-fjord.webp" alt="The explorer vessel cruising between dramatic Norwegian islands" width="1006" height="713" loading="lazy" />
    <span class="documentary__shade" aria-hidden="true"></span>
    <button class="documentary__play" type="button" aria-label="Play the original Oppdrag Sognefjorden trailer">
      <svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M13 9.5c0-1.6 1.8-2.6 3.2-1.7l16 10.5a2 2 0 0 1 0 3.4l-16 10.5c-1.4.9-3.2-.1-3.2-1.7z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <footer class="documentary__footer" data-reveal>
    <a href="#documentary-film"><span class="theme-action"><span class="theme-action__circle theme-action__circle--left" aria-hidden="true">↗</span><span class="theme-action__label">Watch the trailer</span><span class="theme-action__circle theme-action__circle--right" aria-hidden="true">↗</span></span></a>
    <p>International<br />Documentary</p>
  </footer>
</section>
<script>
  const film=document.querySelector<HTMLElement>('.documentary__film');
  const play=film?.querySelector<HTMLButtonElement>('.documentary__play');
  const loadFilm=()=>{
    if(!film||!play||film.querySelector('iframe'))return;
    const player=document.createElement('iframe');
    player.src='https://player.vimeo.com/video/19972686?autoplay=1&title=0&byline=0&portrait=0&dnt=1';
    player.title='Oppdrag Sognefjorden — original documentary trailer by Flash Studio';
    player.allow='autoplay; fullscreen; picture-in-picture';
    player.allowFullscreen=true;
    player.referrerPolicy='strict-origin-when-cross-origin';
    film.append(player);
    play.hidden=true;
    player.focus({preventScroll:true});
  };
  play?.addEventListener('click',loadFilm,{once:true});
  document.querySelector('.documentary__footer a')?.addEventListener('click',()=>{if(!film?.querySelector('iframe'))loadFilm();});
</script>
<style>
  .documentary {padding:4rem var(--page-gutter) 6rem;background:var(--paper);color:var(--navy);}
  .documentary__header,.documentary__film,.documentary__footer {max-width:90rem;margin-inline:auto;}
  .documentary__header {display:flex;flex-direction:column-reverse;align-items:flex-start;gap:1.125rem;margin-bottom:2.75rem;}
  .documentary h2 {margin:0;color:#1e1e1e;font:400 3.9375rem/1.11 var(--heading-font);letter-spacing:-.02em;}
  .documentary__label {display:flex;align-items:center;gap:.75rem;margin:0;color:var(--red);font:400 1.125rem/1.5 'IBM Plex Mono',monospace;}
  .documentary__label span {width:.5rem;height:.5rem;border-radius:50%;background:currentColor;}
  .documentary__film {position:relative;aspect-ratio:1440/722.28;overflow:hidden;border-radius:1.125rem;background:var(--navy);}
  .documentary__poster {display:block;width:100%;height:100%;object-fit:cover;}
  .documentary__shade {position:absolute;inset:0;background:rgb(0 0 0 / .3);pointer-events:none;}
  .documentary__play {position:absolute;top:50%;left:50%;translate:-50% -50%;display:grid;place-items:center;width:5.625rem;height:5.625rem;border:.0625rem solid var(--cream);border-radius:50%;padding:0;background:rgb(255 250 231 / .18);color:var(--cream);backdrop-filter:blur(.25rem);cursor:pointer;transition:background 250ms,color 250ms,scale 350ms;}
  .documentary__play svg {width:2.4375rem;height:2.4375rem;}
  .documentary__play:is(:hover,:focus-visible) {background:var(--cream);color:var(--navy);scale:1.06;}
  .documentary__film :global(iframe) {position:absolute;inset:0;width:100%;height:100%;border:0;background:#000;}
  .documentary__footer {display:flex;justify-content:space-between;align-items:center;gap:2rem;margin-top:1.5rem;}
  .documentary__footer p {margin:0;text-align:right;color:#1e1e1e;font:400 1.6875rem/1.2 var(--heading-font);}
  .documentary__footer a {font:500 .9375rem/1.5 var(--body-font);text-underline-offset:.3rem;}
  .documentary__footer a:hover {color:var(--red);}
  [hidden] {display:none!important;}
  @media(max-width:68.75rem) {.documentary h2 {font-size:3.25rem;}}
  @media(max-width:40rem) {.documentary {padding-top:3rem;padding-bottom:3rem;}.documentary h2 {font-size:2.5rem;}.documentary__label {font-size:.875rem;}.documentary__film {aspect-ratio:4/3;}.documentary__play {width:4rem;height:4rem;}.documentary__play svg {width:1.8125rem;height:1.8125rem;}.documentary__footer {align-items:flex-start;flex-direction:column;gap:1rem;}.documentary__footer p {text-align:left;font-size:1.5rem;}}
  @media(prefers-reduced-motion:reduce) {.documentary__play {transition:none;}}
</style>
