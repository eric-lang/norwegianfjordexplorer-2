---
import BookingButton from './BookingButton.astro';
---
<section class="about" id="about" aria-labelledby="about-heading">
  <div class="about__layout">
    <div class="about__content" data-reveal>
      <p class="about__label">Our Story</p>
      <h2 id="about-heading">Captain Mads<br />Is Your Host.</h2>
      <p class="about__welcome">Welcome to My World!<br />The Team on Tour, Come and Join Us.</p>
      <p>Mads comes from a family rich in traditions and is also the captain in the TV series.</p>
      <p>You are very welcome to come and say hello in the wheelhouse, learn about polar navigation, and hear the stories.</p>
      <p>Come aboard for a closer look at life along the coast, with a crew who know these waters and a host ready to share his world.</p>
      <BookingButton />
    </div>
    <figure class="about__photo" data-reveal style="--reveal-delay:120ms">
      <img src="/images/captain-and-crew.webp" alt="Captain Mads and his crew welcome you beside the explorer vessel" width="1394" height="1000" loading="lazy" />
      <figcaption>Captain Mads &amp; the team · Norwegian Fjord Explorer</figcaption>
    </figure>
  </div>
</section>
<style>
  .about {padding:5rem var(--page-gutter) 6rem;background:var(--paper);color:var(--navy);}
  .about__layout {max-width:90rem;margin:auto;display:grid;grid-template-columns:710fr 639fr;gap:5.625rem;align-items:stretch;}
  .about__content {min-width:0;display:flex;flex-direction:column;align-items:flex-start;}
  .about__label {margin:0 0 1.25rem;color:var(--red);font:400 1.125rem/1.5 'IBM Plex Mono',monospace;}
  .about h2 {margin:0 0 1.75rem;color:#1e1e1e;font:400 3.9375rem/1.11 var(--heading-font);letter-spacing:-.02em;}
  .about__content>p:not(.about__label) {font:400 1.125rem/1.65 var(--body-font);margin:0 0 1.25rem;}
  .about__content>p.about__welcome {font:400 1.6875rem/1.3 var(--heading-font);color:#1e1e1e;}
  .about__content :global(.booking-button) {margin-top:1rem;}
  .about__content :global(.booking-button:is(:hover,:focus-visible)) {color:var(--cream);}
  .about__content :global(.booking-button:is(:hover,:focus-visible) .booking-button__label),.about__content :global(.booking-button:is(:hover,:focus-visible) .booking-button__circle) {background:var(--navy);}
  .about__photo {position:relative;min-width:0;margin:0;border-radius:.5625rem;overflow:hidden;min-height:38rem;background:var(--navy);}
  .about__photo img {position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:48% center;transform:scale(1.04);transition:transform 900ms cubic-bezier(.22,1,.36,1);}
  .about__photo:hover img {transform:scale(1);}
  .about__photo figcaption {position:absolute;bottom:0;left:0;right:0;padding:3rem 1.5rem 1.5rem;color:var(--cream);background:linear-gradient(transparent,rgb(0 0 0 / .8));font:400 .75rem/1.5 'IBM Plex Mono',monospace;}
  @media(max-width:68.75rem) {.about__layout {gap:2.5rem;}.about h2 {font-size:3.25rem;}.about__content>p:not(.about__label) {font-size:1rem;}}
  @media(max-width:47.5rem) {.about__layout {grid-template-columns:1fr;}.about__photo {min-height:0;aspect-ratio:1;}.about {padding-top:3rem;padding-bottom:3rem;}}
  @media(max-width:40rem) {.about h2 {font-size:2.5rem;}.about__label {font-size:.875rem;}}
  @media(prefers-reduced-motion:reduce) {.about__photo img {transition:none;transform:none;}}
</style>
