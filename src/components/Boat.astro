---
import { offerings } from '../data/offerings';
---
<section class="boat" id="vessel" aria-labelledby="boat-heading">
  <div class="boat__layout">
    <div class="boat__photos">
      {offerings.map((item,index)=><div class="boat__photo" data-offering-image={index} hidden={index!==0}><img src={`/images/${item.image}.webp`} alt={item.alt} width="1200" height="1200" loading="lazy" decoding="async" /></div>)}
      <p class="boat__image-label" data-image-label>{offerings[0].label}</p>
    </div>
    <div class="boat__content" data-reveal>
      <header class="boat__header"><p>Service Offerings</p><h2 id="boat-heading">The Boat</h2></header>
      <div class="boat__offerings">
        {offerings.map((item,index)=><div class:list={['offering',{'is-active':index===0}]} data-offering={index}>
          <h3><button type="button" id={`offering-tab-${index}`} aria-expanded={index===0?'true':'false'} aria-controls={`offering-panel-${index}`} data-offering-button={index}><span>{item.label}</span><span class="offering__toggle" aria-hidden="true"></span></button></h3>
          <div class="offering__panel" id={`offering-panel-${index}`} role="region" aria-labelledby={`offering-tab-${index}`} hidden={index!==0}><p>{item.copy}</p></div>
          <span class="offering__timer" aria-hidden="true"><span></span></span>
        </div>)}
      </div>
      <div class="boat__controls"><span>Life aboard Norwegian Fjord Explorer</span><button type="button" data-toggle-autoplay aria-label="Pause automatic offering changes" aria-pressed="false"><span aria-hidden="true">Ⅱ</span><span data-autoplay-label>Pause</span></button></div>
    </div>
  </div>
</section>
<script>
  const section=document.querySelector<HTMLElement>('#vessel');
  if(section) {
    const rows=Array.from(section.querySelectorAll<HTMLElement>('[data-offering]'));
    const buttons=Array.from(section.querySelectorAll<HTMLButtonElement>('[data-offering-button]'));
    const panels=Array.from(section.querySelectorAll<HTMLElement>('.offering__panel'));
    const photos=Array.from(section.querySelectorAll<HTMLElement>('[data-offering-image]'));
    const label=section.querySelector<HTMLElement>('[data-image-label]');
    const toggle=section.querySelector<HTMLButtonElement>('[data-toggle-autoplay]');
    const motion=matchMedia('(prefers-reduced-motion:reduce)');
    const duration=6500;
    let active=0,elapsed=0,last=0,visible=false,paused=false,keyboardFocus=false;
    let animations:Animation[]=[];
    function select(index:number,focus=false) {
      animations.forEach(animation=>animation.cancel());animations=[];
      const previous=active;active=index;elapsed=0;
      rows.forEach((row,i)=>{row.classList.toggle('is-active',i===index);row.style.setProperty('--progress','0');buttons[i].setAttribute('aria-expanded',String(i===index));panels[i].hidden=i!==index;photos[i].hidden=i!==index;photos[i].style.zIndex=i===index?'2':'0';});
      if(label)label.textContent=buttons[index].querySelector('span')?.textContent??'';
      if(previous!==index&&!motion.matches) {
        photos[previous].hidden=false;photos[previous].style.zIndex='1';
        const imageReveal=photos[index].animate([{clipPath:'inset(100% 0 0 0)'},{clipPath:'inset(0)'}],{duration:900,easing:'cubic-bezier(.16,1,.3,1)'});
        animations.push(imageReveal);
        imageReveal.finished.then(()=>{if(active===index)photos[previous].hidden=true;}).catch(()=>{});
        animations.push(photos[index].querySelector('img')!.animate([{transform:'scale(1.06)'},{transform:'scale(1)'}],{duration:1100,easing:'cubic-bezier(.16,1,.3,1)'}));
        animations.push(panels[index].animate([{opacity:0,clipPath:'inset(0 0 100% 0)',transform:'translateY(.5rem)'},{opacity:1,clipPath:'inset(0)',transform:'translateY(0)'}],{duration:650,easing:'cubic-bezier(.22,1,.36,1)'}));
      }
      if(focus)buttons[index].focus({preventScroll:true});
    }
    buttons.forEach((button,index)=>{
      button.addEventListener('click',()=>select(index));
      button.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowDown'||event.key==='ArrowRight')next=(index+1)%buttons.length;else if(event.key==='ArrowUp'||event.key==='ArrowLeft')next=(index-1+buttons.length)%buttons.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=buttons.length-1;else return;event.preventDefault();select(next,true);});
    });
    toggle?.addEventListener('click',()=>{paused=!paused;toggle.setAttribute('aria-pressed',String(paused));toggle.setAttribute('aria-label',paused?'Resume automatic offering changes':'Pause automatic offering changes');toggle.querySelector('[data-autoplay-label]')!.textContent=paused?'Resume':'Pause';toggle.querySelector('[aria-hidden]')!.textContent=paused?'▷':'Ⅱ';});
    section.addEventListener('focusin',()=>{keyboardFocus=buttons.some(button=>button.matches(':focus-visible'));});
    section.addEventListener('focusout',()=>{queueMicrotask(()=>{keyboardFocus=buttons.some(button=>button.matches(':focus-visible'));});});
    const observer=new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;},{threshold:.2});observer.observe(section);
    function updateMotion() {if(toggle)toggle.hidden=motion.matches;rows.forEach(row=>row.classList.toggle('is-static',motion.matches));if(motion.matches){animations.forEach(animation=>animation.cancel());animations=[];photos.forEach((photo,i)=>{photo.hidden=i!==active;});}}
    motion.addEventListener('change',updateMotion);updateMotion();
    function tick(time:number) {
      const delta=last?Math.min(time-last,100):0;last=time;
      if(visible&&!paused&&!keyboardFocus&&!document.hidden&&!motion.matches) {
        elapsed+=delta;rows[active].style.setProperty('--progress',String(Math.min(elapsed/duration,1)));
        if(elapsed>=duration)select((active+1)%buttons.length);
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
<style>
  .boat {max-width:103.125rem;margin-inline:auto;padding:0 var(--page-gutter) 6.75rem;scroll-margin-top:2rem;}
  .boat__layout {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:stretch;gap:5.0625rem;}
  .boat__photos {position:relative;isolation:isolate;min-height:36rem;overflow:hidden;border-radius:1.125rem;background:var(--navy);}
  .boat__photo {position:absolute;inset:0;}
  .boat__photo[hidden] {display:none;}
  .boat__photo img {display:block;width:100%;height:100%;object-fit:cover;}
  .boat__photos::after {content:'';position:absolute;z-index:3;inset:50% 0 0;pointer-events:none;background:linear-gradient(transparent,rgb(0 0 0 / .35));}
  .boat__image-label {position:absolute;z-index:4;bottom:1.25rem;left:1.25rem;right:1.25rem;margin:0;color:var(--cream);font:400 .75rem/1.5 "IBM Plex Mono",monospace;letter-spacing:.05em;text-transform:uppercase;}
  .boat__content {align-self:stretch;}
  .boat__header>p {margin:0 0 1rem;font:400 1.26875rem/1.5 "IBM Plex Mono",monospace;color:var(--red);}
  .boat h2 {margin:0 0 1.6875rem;font:400 3.9375rem/1.11 var(--heading-font);letter-spacing:-.02em;color:#1e1e1e;}
  .offering {--progress:0;position:relative;border-bottom:.0625rem solid rgb(27 54 97 / .16);}
  .offering:first-child {border-top:.0625rem solid rgb(27 54 97 / .16);}
  .offering h3 {margin:0;font:400 1.6875rem/1.15 var(--heading-font);letter-spacing:-.015em;}
  .offering h3 button {display:flex;align-items:center;justify-content:space-between;gap:1rem;width:100%;padding:1.6875rem 0;border:0;background:none;color:#1e1e1e;text-align:left;transition:color 300ms;}
  .offering h3 button:is(:hover,:focus-visible),.offering.is-active h3 button {color:var(--navy);}
  .offering__toggle {position:relative;width:1.6875rem;height:1.6875rem;flex:none;border:.0625rem solid rgb(27 54 97 / .2);border-radius:50%;transition:background 300ms,color 300ms;}
  .offering__toggle::before,.offering__toggle::after {content:'';position:absolute;top:50%;left:50%;width:.625rem;height:.0625rem;background:currentColor;translate:-50% -50%;}
  .offering__toggle::after {rotate:90deg;transition:rotate 350ms;}
  .offering.is-active .offering__toggle {background:var(--navy);color:var(--cream);border-color:var(--navy);}
  .offering.is-active .offering__toggle::after {rotate:0deg;}
  .offering__panel {padding:0 2.75rem 1.6875rem 0;}
  .offering__panel[hidden] {display:none;}
  .offering__panel p {margin:0;color:var(--navy);font:400 1.125rem/1.5 var(--body-font);}
  .offering__timer {position:absolute;left:0;right:0;bottom:-.0625rem;height:.125rem;overflow:hidden;pointer-events:none;}
  .offering__timer>span {display:block;width:100%;height:100%;background:var(--red);transform:scaleX(var(--progress));transform-origin:left;}
  .offering.is-active.is-static .offering__timer>span {transform:scaleX(1);}
  .boat__controls {display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1.125rem;color:rgb(27 54 97 / .8);font:400 .75rem/1.5 var(--body-font);}
  .boat__controls button {display:flex;align-items:center;gap:.375rem;min-height:2rem;border:0;padding:.25rem 0;background:none;color:var(--navy);font:500 .75rem/1.5 var(--body-font);}
  .boat__controls button[hidden] {display:none;}
  .boat__controls button:hover {color:var(--red);}
  @media(max-width:68.75rem) {.boat__layout {gap:2.5rem;}.boat h2 {font-size:3.25rem;color:#1e1e1e;}.offering h3 {font-size:1.5rem;}.offering__panel p {font-size:1rem;}}
  @media(max-width:47.5rem) {.boat {padding:0 1.25rem 4rem;}.boat__layout {grid-template-columns:1fr;gap:2.5rem;}.boat__photos {min-height:0;aspect-ratio:1;}.boat__header>p {font-size:1rem;}.offering h3 button {padding:1.25rem 0;}.offering__panel {padding-bottom:1.25rem;}.boat__controls {flex-wrap:wrap;}}
  @media(max-width:40rem) {.boat h2 {font-size:2.5rem;color:#1e1e1e;}}
  @media(prefers-reduced-motion:reduce) {.offering h3 button,.offering__toggle,.offering__toggle::after {transition:none;}}
.offering h3 button,.offering.is-active h3 button,.offering h3 button:is(:hover,:focus-visible) {color:#1e1e1e;}
</style>
