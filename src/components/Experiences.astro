---
import { experiences } from '../data/experiences';
import Arrow from './Arrow.astro';
const captions = ['Stay a little longer. Explore a little further.', 'Slow mornings. A seat beside the sea.', 'Warm company. Extraordinary Arctic evenings.', 'Good food. A different view of the coast.', 'Quiet fjords. A little northern magic.', 'A taste of the Arctic. A day to remember.'];
const labels = ['Stay aboard', 'Bed & breakfast', 'Evening cruise', 'Dinner on board', 'Explore the fjord', 'Cruise & lunch'];
---
<section class="experiences" id="experiences" aria-labelledby="experiences-heading">
  <header class="experiences__header" data-reveal>
    <p class="experiences__locations"><span>Tromsø</span><span>Lofoten & Vesterålen</span><span>Special Cruises</span></p>
    <h2 id="experiences-heading">Choose your Experience</h2>
    <p class="experiences__intro">Stay a little longer, explore a little further. From a cosy night aboard to dinner on the fjord, discover your own way to experience Arctic Norway with our crew.</p>
  </header>
  <div class="experience-tabs" role="tablist" aria-label="Cruise categories" data-reveal style="--reveal-delay:80ms">
    {experiences.map((category,index)=><button type="button" role="tab" id={`tab-${category.id}`} aria-controls={`panel-${category.id}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-tab={category.id}>{category.label}</button>)}
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-tab-status></p>
  {experiences.map((category,index)=><div class="experience-panel" role="tabpanel" id={`panel-${category.id}`} aria-labelledby={`tab-${category.id}`} tabindex="0" hidden={index!==0}>
    <div class="experience-grid">
      {category.cards.map((card,cardIndex)=><a class="experience-card" href="#panel-booking" data-open-panel="booking" data-experience-title={card.title} data-experience-summary={`${category.label} · ${card.detail}`} aria-label={`Enquire about ${card.title}`} aria-haspopup="dialog" data-reveal style={`--reveal-delay:${(cardIndex%3)*90}ms`}>
        <div class="experience-card__photo">
          <img src={`/images/${card.image}.webp`} alt={card.alt} width="960" height="754" loading="lazy" decoding="async" />
          <span class="experience-card__arrow" aria-hidden="true"><Arrow /></span>
          <span class="experience-card__caption">{captions[cardIndex]}</span>
          <span class="experience-card__badge">{category.id==='charter'?'Private charter':labels[cardIndex]}</span>
        </div>
        <div class="experience-card__body">
          <p class="experience-card__location">{category.label}<span aria-hidden="true"> · </span>Norway</p>
          <h3>{card.title}</h3>
          <p class="experience-card__description">{card.description}</p>
          <div class="experience-card__footer">
            <p class="experience-card__detail"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5" /><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>{card.detail}</p>
            <p class="experience-card__price">{card.price?<><span>From </span><strong>{card.price}</strong><span class="experience-card__euro"> / {card.euro}</span></>:<strong>Request a quote <span aria-hidden="true">↗</span></strong>}</p>
          </div>
        </div>
      </a>)}
    </div>
  </div>)}
</section>
<script>
  const section = document.querySelector<HTMLElement>('#experiences');
  const tabs = Array.from(section?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
  const panels = Array.from(section?.querySelectorAll<HTMLElement>('[role="tabpanel"]') ?? []);
  const status = section?.querySelector<HTMLElement>('[data-tab-status]');

  function selectTab(id: string, focus = false) {
    const selected = tabs.find((tab) => tab.dataset.tab === id);
    if (!selected) return;
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => {
      const wasHidden = panel.hidden;
      panel.hidden = panel.id !== selected.getAttribute('aria-controls');
      if (wasHidden && !panel.hidden && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        panel.querySelectorAll<HTMLElement>('.experience-card.is-revealed').forEach((card, index) => {
          card.animate([
            { opacity: 0, transform: 'translateY(1.125rem)' },
            { opacity: 1, transform: 'translateY(0)' },
          ], { duration: 550, delay: (index % 3) * 90, easing: 'cubic-bezier(.22, 1, .36, 1)', fill: 'backwards' });
        });
      }
    });
    if (status) status.textContent = `6 experiences in ${selected.textContent?.trim()}.`;
    if (focus) {
      selected.focus({ preventScroll: true });
      selected.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab.dataset.tab ?? ''));
    tab.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectTab(tabs[next].dataset.tab ?? '', true);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-experience-tab]').forEach((link) => {
    link.addEventListener('click', () => selectTab(link.dataset.experienceTab ?? 'tromso'));
  });
</script>
<style>
  .experiences {max-width:103.125rem;margin-inline:auto;padding:6.75rem var(--page-gutter);scroll-margin-top:1.5rem;}
  .experiences__header {text-align:center;margin:0 auto 3rem;max-width:61.875rem;}
  .experiences__locations {display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:1.125rem;margin:0 0 1.125rem;font:400 1.125rem/1.5 var(--body-font);color:rgb(27 54 97 / .8);}
  .experiences__locations span+span {border-left:.0625rem solid rgb(27 54 97 / .15);padding-left:1.125rem;}
  .experiences h2 {margin:0 0 1.125rem;font:400 3.9375rem/1.11 var(--heading-font);letter-spacing:-.02em;text-wrap:balance;color:#1e1e1e;}
  .experiences__intro {max-width:46.5rem;margin:0 auto;color:var(--navy);font:400 1.125rem/1.5 var(--body-font);text-wrap:pretty;}
  .experience-tabs {display:flex;justify-content:center;flex-wrap:wrap;gap:.75rem;margin:0 0 3.75rem;}
  .experience-tabs button {border:.0625rem solid rgb(27 54 97 / .16);border-radius:999rem;padding:.75rem 1.5rem;color:var(--navy);background:transparent;font:500 1rem/1.5 Satoshi,var(--body-font);transition:background-color 250ms,color 250ms,border-color 250ms;}
  .experience-tabs button[aria-selected='true'] {background:var(--navy);color:var(--cream);border-color:var(--navy);}
  .experience-tabs button:is(:hover,:focus-visible) {background:#eae1c1;color:var(--navy);border-color:rgb(27 54 97 / .3);}
  .experience-panel[hidden] {display:none;}
  .experience-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:2.25rem;row-gap:3.5rem;}
  .experience-card {--card-background:var(--paper);display:flex;flex-direction:column;min-width:0;gap:1.40625rem;border:0;border-radius:1.125rem;color:var(--navy);background:var(--card-background);text-decoration:none;transition:background-color 450ms,color 450ms;}
  .experience-card:is(:hover,:focus-visible) {--card-background:#fffdf7;color:var(--navy);}
  .experience-card__photo {position:relative;isolation:isolate;overflow:hidden;aspect-ratio:5/4;border-radius:1.125rem;box-shadow:0 .375rem 1.5rem rgb(9 28 42 / .05);}
  .experience-card__photo img {display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.065);transition:transform 900ms cubic-bezier(.22,1,.36,1);}
  .experience-card__photo::after {content:'';position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgb(1 15 24 / .04),rgb(1 15 24 / .09) 50%,rgb(1 15 24 / .2));transition:background-color 600ms;}
  .experience-card:is(:hover,:focus-visible) .experience-card__photo img {transform:scale(1.005);}
  .experience-card:is(:hover,:focus-visible) .experience-card__photo::after {background-color:rgb(1 15 24 / .22);}
  .experience-card__arrow {position:absolute;z-index:2;top:.875rem;right:.875rem;display:grid;place-items:center;width:2.75rem;height:2.75rem;background:var(--cream);color:var(--navy);border-radius:50%;transition:transform 450ms,color 450ms,background-color 450ms;}
  .experience-card__arrow :global(svg) {width:1.125rem;height:1.125rem;}
  .experience-card:is(:hover,:focus-visible) .experience-card__arrow {transform:rotate(45deg);background:var(--navy);color:var(--cream);}
  .experience-card__badge {position:absolute;left:.84375rem;bottom:.84375rem;z-index:2;padding:.41625rem .84375rem;border:.0625rem solid rgb(255 255 255 / .18);border-radius:999rem;background:rgb(0 0 0 / .4);backdrop-filter:blur(.5rem);color:white;font:600 .875rem/1.5 var(--body-font);}
  .experience-card__caption {position:absolute;z-index:2;left:1.125rem;right:1.125rem;bottom:4.5rem;max-width:18rem;opacity:0;transform:translateY(.5rem);color:var(--cream);font:400 1.125rem/1.4 var(--body-font);transition:opacity 450ms,transform 600ms cubic-bezier(.22,1,.36,1);text-shadow:0 .125rem .5rem rgb(0 0 0 / .3);}
  .experience-card:is(:hover,:focus-visible) .experience-card__caption {opacity:1;transform:translateY(0);}
  .experience-card__body {display:flex;flex-direction:column;flex:1;padding:0 .5rem 1.25rem;}
  .experience-card__location {margin:0 0 .8375rem;color:rgb(27 54 97 / .8);font:400 1.125rem/1.5 var(--body-font);transition:color 450ms;}
  .experience-card h3 {margin:0 0 .8375rem;color:#1e1e1e;font:400 1.96875rem/1.2 var(--heading-font);letter-spacing:-.015em;transition:color 450ms;text-wrap:pretty;}
  .experience-card__description {margin:0 0 1.5rem;font:400 1.0625rem/1.5 var(--body-font);color:rgb(27 54 97 / .85);transition:color 450ms;}
  .experience-card:is(:hover,:focus-visible) :is(h3,.experience-card__location,.experience-card__description) {color:var(--navy);}
  .experience-card__footer {margin-top:auto;padding-top:.875rem;border-top:.0625rem solid rgb(27 54 97 / .12);}
  .experience-card__detail {display:flex;align-items:center;gap:.5rem;margin:0 0 .625rem;font:400 .875rem/1.5 var(--body-font);}
  .experience-card__detail svg {width:1.25rem;height:1.25rem;flex:none;}
  .experience-card__price {margin:0;font:400 1rem/1.5 var(--body-font);}
  .experience-card__price strong {font-weight:600;}
  .experience-card__euro {color:rgb(27 54 97 / .8);font-size:.875rem;}
  @media(max-width:68.75rem) {.experience-grid {grid-template-columns:repeat(2,minmax(0,1fr));gap:2.5rem 1.5rem;}.experiences h2 {font-size:3.25rem;color:#1e1e1e;}}
  @media(max-width:40rem) {.experiences {padding:4rem 1.25rem;}.experiences__header {margin-bottom:2rem;}.experiences h2 {font-size:2.5rem;color:#1e1e1e;}.experiences__intro {font-size:1rem;}.experiences__locations {font-size:.75rem;gap:.625rem;}.experiences__locations span+span {padding-left:.625rem;}.experience-tabs {gap:.5rem;margin-bottom:2rem;}.experience-tabs button {padding:.625rem 1rem;font-size:.875rem;}.experience-grid {grid-template-columns:1fr;gap:2rem;}.experience-card h3 {font-size:1.96875rem;}.experience-card__location {font-size:1rem;}.experience-card__description {font-size:1rem;}}
  @media(hover:none) {.experience-card__caption {opacity:1;transform:none;font-size:1rem;}.experience-card__photo::after {background-color:rgb(1 15 24 / .15);}}
  @media(prefers-reduced-motion:reduce) {.experience-tabs button,.experience-card,.experience-card__photo img,.experience-card__photo::after,.experience-card__arrow,.experience-card__caption,.experience-card h3,.experience-card__location,.experience-card__description {transition:none;}}
.experience-card h3,.experience-card:is(:hover,:focus-visible) h3 {color:#1e1e1e;}
</style>
