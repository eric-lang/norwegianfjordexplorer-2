---
import BookingButton from './BookingButton.astro';
---
<section class="cruise-cta" id="plan-your-cruise" aria-labelledby="cruise-cta-heading">
  <div class="cruise-cta__banner" data-reveal>
    <div class="cruise-cta__content">
      <p class="cruise-cta__eyebrow">Your next chapter, on the water</p>
      <h2 id="cruise-cta-heading">Ready for your next<br />Arctic adventure?</h2>
      <p class="cruise-cta__copy">Tell us where you’d like to explore, who’s coming along, and when you’d like to sail. Our crew will help you plan a fjord cruise, a stay aboard, or a private charter around you.</p>
    </div>
    <div class="cruise-cta__action">
      <p>Tromsø · Lofoten<br /> &amp; beyond</p>
      <BookingButton variant="red" label="Plan your cruise" />
    </div>
  </div>
</section>
<style>
  .cruise-cta {max-width:103.125rem;margin-inline:auto;padding:0 var(--page-gutter) 6.75rem;scroll-margin-top:1.5rem;}
  .cruise-cta__banner {display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:5.625rem;padding:3.65625rem;border-radius:1.25rem;background:#0f1f38;color:var(--cream);}
  .cruise-cta__eyebrow {margin:0 0 1.125rem;font:400 .75rem/1.5 "IBM Plex Mono",monospace;letter-spacing:.06em;text-transform:uppercase;}
  .cruise-cta h2 {margin:0 0 1.074rem;max-width:38rem;font:400 2.53125rem/1.07 var(--heading-font);letter-spacing:-.02em;text-wrap:balance;color:var(--cream);}
  .cruise-cta__copy {max-width:48rem;margin:0;font:400 1.125rem/1.5 var(--body-font);color:var(--cream);text-wrap:pretty;}
  .cruise-cta__action {display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:1.125rem;}
  .cruise-cta__action p {margin:0;font:400 .875rem/1.5 "IBM Plex Mono",monospace;letter-spacing:.02em;}
  @media(max-width:68.75rem) {.cruise-cta__banner {gap:2.5rem;padding:2.5rem;}}
  @media(max-width:47.5rem) {.cruise-cta {padding:0 1.25rem 4rem;}.cruise-cta__banner {grid-template-columns:1fr;gap:2rem;padding:2rem 1.5rem;}.cruise-cta h2 {font-size:2.25rem;color:var(--cream);}.cruise-cta__copy {font-size:1rem;}.cruise-cta__action {gap:1rem;}.cruise-cta__action p br {display:none;}}
.cruise-cta :global(.booking-button--cream:is(:hover,:focus-visible) .booking-button__label),.cruise-cta :global(.booking-button--cream:is(:hover,:focus-visible) .booking-button__circle) {background:var(--red);}
</style>



