---
import Hero from '../components/Hero.astro';
import Experiences from '../components/Experiences.astro';
import CruiseCTA from '../components/CruiseCTA.astro';
import Boat from '../components/Boat.astro';
import Routes from '../components/Routes.astro';
import Stops from '../components/Stops.astro';
import Sustainability from '../components/Sustainability.astro';
import About from '../components/About.astro';
import CrewGallery from '../components/CrewGallery.astro';
import Documentary from '../components/Documentary.astro';
import Charters from '../components/Charters.astro';
import DeckPlans from '../components/DeckPlans.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
